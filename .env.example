# Airtel Money API Configuration
# Copy this file to .env and fill in your credentials

# Airtel Developer Portal Credentials
AIRTEL_CLIENT_ID=your_client_id_here
AIRTEL_CLIENT_SECRET=your_client_secret_here

# Environment Configuration
AIRTEL_SANDBOX=true  # Set to false for production
AIRTEL_COUNTRY=KE
AIRTEL_CURRENCY=KES

# Webhook Configuration
CALLBACK_URL=https://your-domain.com/webhook/airtel
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=5000

# API Server Configuration
API_PORT=5001

# Security (optional - for webhook signature verification)
AIRTEL_WEBHOOK_SECRET=your_webhook_secret_here
